+// PROTOTYPE (activation rounding experiment): evaluate IQ1_S / IQ2_XXS / IQ2_S dot products against a Q8_0 activation
+// (32-value blocks, like the CUDA kernels' Q8_1) instead of Q8_K (256-value blocks). Weights are dequantized exactly,
+// so the only difference from stock is how the activation is rounded.
+static void ggml_act32_vec_dot(enum ggml_type wt, int n, float * GGML_RESTRICT s, const void * GGML_RESTRICT vx,
+                               const void * GGML_RESTRICT vy) {
+    static _Thread_local float wbuf[32768];
+    GGML_ASSERT(n <= 32768 && n % 32 == 0);
+    ggml_get_type_traits(wt)->to_float(vx, wbuf, n);
+    const block_q8_0 * y = (const block_q8_0 *) vy;
+    float sum = 0.0f;
+    for (int b = 0; b < n / 32; ++b) {
+        float acc = 0.0f;
+        for (int i = 0; i < 32; ++i) acc += wbuf[b * 32 + i] * (float) y[b].qs[i];
+        sum += acc * GGML_FP16_TO_FP32(y[b].d);
+    }
+    *s = sum;
+}
+#define ACT32_FN(NAME, TYPE) \
+    static void NAME(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, \
+                     const void * GGML_RESTRICT vy, size_t by, int nrc) { \
+        GGML_UNUSED(bs); GGML_UNUSED(bx); GGML_UNUSED(by); GGML_ASSERT(nrc == 1); ggml_act32_vec_dot(TYPE, n, s, vx, vy); }
+ACT32_FN(ggml_act32_vec_dot_iq1_s,   GGML_TYPE_IQ1_S)
+ACT32_FN(ggml_act32_vec_dot_iq2_xxs, GGML_TYPE_IQ2_XXS)
+ACT32_FN(ggml_act32_vec_dot_iq2_s,   GGML_TYPE_IQ2_S)
+
