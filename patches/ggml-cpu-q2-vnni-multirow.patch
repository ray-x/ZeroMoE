+static MOESTREAM_Q2_0_VNNI_TARGET void
+moestream_ggml_q2_0_dot_vnni_4rows(float *output,
+                                   const block_q2_0 *weights,
+                                   size_t weight_row_bytes,
+                                   const block_q8_0 *activations, int n) {
+    __m512 accum0 = _mm512_setzero_ps();
+    __m512 accum1 = _mm512_setzero_ps();
+    __m512 accum2 = _mm512_setzero_ps();
+    __m512 accum3 = _mm512_setzero_ps();
+    const int blocks = n / QK2_0;
+
+    for (int b = 0; b < blocks; ++b) {
+        const block_q8_0 *x0 = &activations[2 * b];
+        const block_q8_0 *x1 = &activations[2 * b + 1];
+        const __m512i xv = _mm512_inserti64x4(
+            _mm512_castsi256_si512(
+                _mm256_loadu_si256((const __m256i *) x0->qs)),
+            _mm256_loadu_si256((const __m256i *) x1->qs), 1);
+        const __m512i sx16 = _mm512_maddubs_epi16(_mm512_set1_epi8(1), xv);
+        const __m512i sx32 = _mm512_madd_epi16(sx16, _mm512_set1_epi16(1));
+        const float xscale0 = GGML_CPU_FP16_TO_FP32(x0->d);
+        const float xscale1 = GGML_CPU_FP16_TO_FP32(x1->d);
+
+        const block_q2_0 *w0 = (const block_q2_0 *)
+            ((const char *) weights + 0 * weight_row_bytes) + b;
+        const block_q2_0 *w1 = (const block_q2_0 *)
+            ((const char *) weights + 1 * weight_row_bytes) + b;
+        const block_q2_0 *w2 = (const block_q2_0 *)
+            ((const char *) weights + 2 * weight_row_bytes) + b;
+        const block_q2_0 *w3 = (const block_q2_0 *)
+            ((const char *) weights + 3 * weight_row_bytes) + b;
+
+        const __m512i wv0 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(moestream_ggml_q2_0_unpack_half_vnni(w0->qs)),
+            moestream_ggml_q2_0_unpack_half_vnni(w0->qs + 8), 1);
+        const __m512i wv1 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(moestream_ggml_q2_0_unpack_half_vnni(w1->qs)),
+            moestream_ggml_q2_0_unpack_half_vnni(w1->qs + 8), 1);
+        const __m512i wv2 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(moestream_ggml_q2_0_unpack_half_vnni(w2->qs)),
+            moestream_ggml_q2_0_unpack_half_vnni(w2->qs + 8), 1);
+        const __m512i wv3 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(moestream_ggml_q2_0_unpack_half_vnni(w3->qs)),
+            moestream_ggml_q2_0_unpack_half_vnni(w3->qs + 8), 1);
+
+        const __m512i corrected0 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv0, xv), sx32);
+        const __m512i corrected1 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv1, xv), sx32);
+        const __m512i corrected2 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv2, xv), sx32);
+        const __m512i corrected3 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv3, xv), sx32);
+
+        const float weight_scale0 = GGML_CPU_FP16_TO_FP32(w0->d);
+        const float weight_scale1 = GGML_CPU_FP16_TO_FP32(w1->d);
+        const float weight_scale2 = GGML_CPU_FP16_TO_FP32(w2->d);
+        const float weight_scale3 = GGML_CPU_FP16_TO_FP32(w3->d);
+        const __m512 scales00 = _mm512_set1_ps(weight_scale0 * xscale0);
+        const __m512 scales01 = _mm512_set1_ps(weight_scale0 * xscale1);
+        const __m512 scales10 = _mm512_set1_ps(weight_scale1 * xscale0);
+        const __m512 scales11 = _mm512_set1_ps(weight_scale1 * xscale1);
+        const __m512 scales20 = _mm512_set1_ps(weight_scale2 * xscale0);
+        const __m512 scales21 = _mm512_set1_ps(weight_scale2 * xscale1);
+        const __m512 scales30 = _mm512_set1_ps(weight_scale3 * xscale0);
+        const __m512 scales31 = _mm512_set1_ps(weight_scale3 * xscale1);
+
+        accum0 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected0),
+            _mm512_mask_blend_ps(0xff00, scales00, scales01), accum0);
+        accum1 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected1),
+            _mm512_mask_blend_ps(0xff00, scales10, scales11), accum1);
+        accum2 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected2),
+            _mm512_mask_blend_ps(0xff00, scales20, scales21), accum2);
+        accum3 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected3),
+            _mm512_mask_blend_ps(0xff00, scales30, scales31), accum3);
+    }
+
+    output[0] = _mm512_reduce_add_ps(accum0);
+    output[1] = _mm512_reduce_add_ps(accum1);
+    output[2] = _mm512_reduce_add_ps(accum2);
+    output[3] = _mm512_reduce_add_ps(accum3);
+}
