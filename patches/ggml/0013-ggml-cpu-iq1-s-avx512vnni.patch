diff --git a/src/ggml-cpu/arch/x86/quants.c b/src/ggml-cpu/arch/x86/quants.c
--- a/src/ggml-cpu/arch/x86/quants.c
+++ b/src/ggml-cpu/arch/x86/quants.c
@@ -3789,7 +3789,58 @@
 
     const int nb = n / QK_K;
 
-#if defined __AVX2__
+#if defined(__AVX512VNNI__) && defined(__AVX512VL__) && defined(__AVX2__)
+
+    // IQ1_S is Ling's dominant expert format (gate and up in 63 routed
+    // layers). Use VNNI to fuse four signed-grid byte products directly into
+    // each int32 lane; the AVX2 path below uses maddubs followed by madd.
+    __m256 accum = _mm256_setzero_ps();
+    float accum1 = 0;
+    const __m256i zero = _mm256_setzero_si256();
+
+    for (int i = 0; i < nb; ++i) {
+        const int8_t * q8 = y[i].qs;
+        const uint8_t * qs = x[i].qs;
+        const uint16_t * qh = x[i].qh;
+        __m256i sumi = _mm256_setzero_si256();
+        int sumi1 = 0;
+
+        for (int ib = 0; ib < QK_K/32; ib += 2) {
+#ifdef __BMI2__
+            const uint64_t packed_idx1 = _pdep_u64(*(const uint32_t *)qs, 0x00ff00ff00ff00ffULL) | _pdep_u64(qh[ib], 0x700070007000700ULL);
+            const uint64_t packed_idx2 = _pdep_u64(*(const uint32_t *)(qs + 4), 0x00ff00ff00ff00ffULL) | _pdep_u64(qh[ib + 1], 0x700070007000700ULL);
+            const uint16_t *idx1 = (const uint16_t *)(&packed_idx1);
+            const uint16_t *idx2 = (const uint16_t *)(&packed_idx2);
+            const __m256i q1b_1 = _mm256_set_epi64x(iq1s_grid[idx1[3]], iq1s_grid[idx1[2]], iq1s_grid[idx1[1]], iq1s_grid[idx1[0]]);
+            const __m256i q1b_2 = _mm256_set_epi64x(iq1s_grid[idx2[3]], iq1s_grid[idx2[2]], iq1s_grid[idx2[1]], iq1s_grid[idx2[0]]);
+#else
+            const __m256i q1b_1 = _mm256_set_epi64x(iq1s_grid[qs[3] | ((qh[ib+0] >> 1) & 0x700)], iq1s_grid[qs[2] | ((qh[ib+0] << 2) & 0x700)],
+                                                    iq1s_grid[qs[1] | ((qh[ib+0] << 5) & 0x700)], iq1s_grid[qs[0] | ((qh[ib+0] << 8) & 0x700)]);
+            const __m256i q1b_2 = _mm256_set_epi64x(iq1s_grid[qs[7] | ((qh[ib+1] >> 1) & 0x700)], iq1s_grid[qs[6] | ((qh[ib+1] << 2) & 0x700)],
+                                                    iq1s_grid[qs[5] | ((qh[ib+1] << 5) & 0x700)], iq1s_grid[qs[4] | ((qh[ib+1] << 8) & 0x700)]);
+#endif
+            qs += 8;
+            const __m256i q8b_1 = _mm256_loadu_si256((const __m256i*)q8); q8 += 32;
+            const __m256i q8b_2 = _mm256_loadu_si256((const __m256i*)q8); q8 += 32;
+            const __m256i dot1 = _mm256_dpbusd_epi32(zero, _mm256_abs_epi8(q1b_1), _mm256_sign_epi8(q8b_1, q1b_1));
+            const __m256i dot2 = _mm256_dpbusd_epi32(zero, _mm256_abs_epi8(q1b_2), _mm256_sign_epi8(q8b_2, q1b_2));
+            const int32_t ls1 = 2*((qh[ib+0] >> 12) & 7) + 1;
+            const int32_t ls2 = 2*((qh[ib+1] >> 12) & 7) + 1;
+            const __m256i p1 = _mm256_mullo_epi32(dot1, _mm256_set1_epi32(ls1));
+            const __m256i p2 = _mm256_mullo_epi32(dot2, _mm256_set1_epi32(ls2));
+            sumi = _mm256_add_epi32(sumi, _mm256_add_epi32(p1, p2));
+            sumi1 += (y[i].bsums[2*ib+0] + y[i].bsums[2*ib+1]) * (qh[ib+0] & 0x8000 ? -1 : 1) * ls1
+                   + (y[i].bsums[2*ib+2] + y[i].bsums[2*ib+3]) * (qh[ib+1] & 0x8000 ? -1 : 1) * ls2;
+        }
+
+        const float d = y[i].d * GGML_CPU_FP16_TO_FP32(x[i].d);
+        accum = _mm256_fmadd_ps(_mm256_set1_ps(d), _mm256_cvtepi32_ps(sumi), accum);
+        accum1 += d * sumi1;
+    }
+
+    *s = hsum_float_8(accum) + IQ1S_DELTA * accum1;
+
+#elif defined __AVX2__
 
     __m256 accum = _mm256_setzero_ps();
     float accum1 = 0;
