+++ b/src/ggml-cuda/ggml-cuda.cu
@@ -4832,6 +4832,18 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
                     }
                     use_cuda_graph = true;
                     cuda_graph_update_required = true;
+                } else if (graph->instance == nullptr &&
+                           std::getenv("ZEROMOE_GGML_CUDA_GRAPH_CAPTURE_ON_FIRST_CALL") != nullptr) {
+                    // ZeroMoE's full prefill/decode graphs have a single long-lived
+                    // layout and already own stable tensor buffers before compute.
+                    // In this opt-in mode, capture and launch the first real call
+                    // instead of first evaluating every CUDA node individually.
+                    // This can remove a large cold-path penalty; keep the default
