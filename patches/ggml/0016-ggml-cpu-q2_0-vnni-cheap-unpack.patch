ggml-cpu: Q2_0 x Q8_0 VNNI dot with a cheaper weight unpack

The 2-bit weights are widened with one 32-bit load/shift/ternary-logic sequence (6 vector ops per 64 weights) instead of
the previous byte-lane unpack (~28). The accumulation order and rounding points are unchanged, so results are
bit-identical to the old kernel (checked on 16,384 outputs and on decode logits); the cold-expert op runs about 2.2x
faster per thread.

diff -ruN a/src/ggml-cpu/arch/x86/quants.c b/src/ggml-cpu/arch/x86/quants.c
--- a/src/ggml-cpu/arch/x86/quants.c	2026-10-28 10:57:18.969408448 +1100
+++ b/src/ggml-cpu/arch/x86/quants.c	2026-10-28 10:57:18.971441059 +1100
@@ -42,123 +42,61 @@
     return _mm256_unpacklo_epi16(q01, q23);
 }
 
+// Unpack-and-scale restructuring: 6 vector ops per 64 weights instead of ~28 (bit-identical results).
+static ZEROMOE_Q2_0_VNNI_TARGET __m512i q2_0_unpack64(const uint8_t *packed) {
+    // 16 packed bytes -> 64 bytes in natural order (element 4m+f = field f of byte m), values 0..3
+    const __m512i d = _mm512_cvtepu8_epi32(_mm_loadu_si128((const __m128i *) packed));
+    const __m512i s6 = _mm512_slli_epi32(d, 6);
+    const __m512i s12 = _mm512_slli_epi32(d, 12);
+    const __m512i s18 = _mm512_slli_epi32(d, 18);
+    const __m512i o3 = _mm512_ternarylogic_epi32(d, s6, s12, 0xFE);                    // d | s6 | s12
+    return _mm512_ternarylogic_epi32(o3, s18, _mm512_set1_epi32(0x03030303), 0xA8);   // (o3 | s18) & mask
+}
