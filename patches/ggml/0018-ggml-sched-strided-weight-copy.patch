 // backend copy
 
+// ZEROMOE: a static weight whose HOST source is strided (a pinned DDR expert
+// plane keeps a padded per-expert stride) may be copied into a DENSE device
+// tensor: the CUDA kernels require contiguous weights, and the plain linear
+// copy would land the padded source span at the wrong offsets, which surfaced
+// as all-NaN prefill on a qwen35moe model whose experts alias a strided DDR
+// arena. Only the expert axis is assumed padded -- the layout every ggml expert
+// plane uses -- so the inner two dimensions stay contiguous per expert slab.
+static bool ggml_backend_copy_strided_host_tensor(const struct ggml_tensor * src, struct ggml_tensor * dst) {
+    if (src->data == NULL || dst->data == NULL) {
+        return false;
+    }
+    if (src->type != dst->type || src->ne[0] != dst->ne[0] || src->ne[1] != dst->ne[1] ||
+        src->ne[2] != dst->ne[2] || src->ne[3] != dst->ne[3]) {
+        return false;
+    }
+    // nb[0] is a whole quantization block (e.g. 50 bytes per 256 IQ1_S
+    // weights), so the contiguous-row test must use ggml_row_size, not
+    // nb[0]*ne[0].
+    if (src->nb[1] != ggml_row_size(src->type, src->ne[0]) ||
+        dst->nb[1] != ggml_row_size(dst->type, dst->ne[0])) {
+        return false; // not expert-axis-only padding
+    }
+    const size_t inner = ggml_row_size(src->type, src->ne[0]) * (size_t) src->ne[1];
+    if (inner == 0) {
+        return false;
+    }
+    for (int64_t i3 = 0; i3 < src->ne[3]; ++i3) {
+        ggml_backend_tensor_set_2d(dst,
+            (const char *) src->data + (size_t) i3*src->nb[3], (size_t) i3*dst->nb[3],
+            inner, (size_t) src->ne[2], dst->nb[2], src->nb[2]);
+    }
+    return true;
+}
