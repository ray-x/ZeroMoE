 #define UNUSED GGML_UNUSED
 
+#if defined(__GNUC__) || defined(__clang__)
+#define ZEROMOE_Q2_0_VNNI_TARGET \
+    __attribute__((target("avx2,avx512f,avx512bw,avx512vl,avx512vnni")))
+
+static ZEROMOE_Q2_0_VNNI_TARGET __m256i
+zeromoe_ggml_q2_0_unpack_half_vnni(const uint8_t *packed) {
+    const __m128i bytes = _mm_loadl_epi64((const __m128i *) packed);
+    const __m256i q = _mm256_inserti128_si256(
+        _mm256_castsi128_si256(bytes), _mm_srli_si128(bytes, 4), 1);
+    const __m256i mask = _mm256_set1_epi8(0x03);
+    const __m256i q0 = _mm256_and_si256(q, mask);
+    const __m256i q1 = _mm256_and_si256(_mm256_srli_epi16(q, 2), mask);
+    const __m256i q2 = _mm256_and_si256(_mm256_srli_epi16(q, 4), mask);
+    const __m256i q3 = _mm256_and_si256(_mm256_srli_epi16(q, 6), mask);
+    const __m256i q01 = _mm256_unpacklo_epi8(q0, q1);
+    const __m256i q23 = _mm256_unpacklo_epi8(q2, q3);
+    return _mm256_unpacklo_epi16(q01, q23);
+}
+
+static ZEROMOE_Q2_0_VNNI_TARGET float
+zeromoe_ggml_q2_0_dot_vnni(const block_q2_0 *weights,
+                             const block_q8_0 *activations, int n) {
+    __m512 accum = _mm512_setzero_ps();
+    const int blocks = n / QK2_0;
+    for (int b = 0; b < blocks; ++b) {
+        const block_q2_0 *wb = &weights[b];
+        const float wd = GGML_CPU_FP16_TO_FP32(wb->d);
+        const __m256i w0 = zeromoe_ggml_q2_0_unpack_half_vnni(wb->qs);
+        const __m256i w1 = zeromoe_ggml_q2_0_unpack_half_vnni(wb->qs + 8);
+        const block_q8_0 *x0 = &activations[2 * b];
+        const block_q8_0 *x1 = &activations[2 * b + 1];
+        const __m512i wv = _mm512_inserti64x4(_mm512_castsi256_si512(w0), w1, 1);
+        const __m512i xv = _mm512_inserti64x4(
+            _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) x0->qs)),
+            _mm256_loadu_si256((const __m256i *) x1->qs), 1);
+        const __m512i sums = _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv, xv);
+        const __m512i sx32 = _mm512_dpbusd_epi32(
+            _mm512_setzero_si512(), _mm512_set1_epi8(1), xv);
+        const __m512i corrected = _mm512_sub_epi32(sums, sx32);
+        const __m512 scale0 = _mm512_set1_ps(
+            wd * GGML_CPU_FP16_TO_FP32(x0->d));
+        const __m512 scale1 = _mm512_set1_ps(
+            wd * GGML_CPU_FP16_TO_FP32(x1->d));
+        const __m512 scales = _mm512_mask_blend_ps(0xff00, scale0, scale1);
+        accum = _mm512_fmadd_ps(_mm512_cvtepi32_ps(corrected), scales, accum);
+    }
+    return _mm512_reduce_add_ps(accum);
+}
+
+static ZEROMOE_Q2_0_VNNI_TARGET void
+zeromoe_ggml_q2_0_dot_vnni_4rows(float *output,
+                                   const block_q2_0 *weights,
+                                   size_t weight_row_bytes,
+                                   const block_q8_0 *activations, int n) {
+    __m512 accum0 = _mm512_setzero_ps();
+    __m512 accum1 = _mm512_setzero_ps();
+    __m512 accum2 = _mm512_setzero_ps();
+    __m512 accum3 = _mm512_setzero_ps();
+    const int blocks = n / QK2_0;
+
+    for (int b = 0; b < blocks; ++b) {
+        const block_q8_0 *x0 = &activations[2 * b];
+        const block_q8_0 *x1 = &activations[2 * b + 1];
+        const __m512i xv = _mm512_inserti64x4(
+            _mm512_castsi256_si512(
+                _mm256_loadu_si256((const __m256i *) x0->qs)),
+            _mm256_loadu_si256((const __m256i *) x1->qs), 1);
+        const __m512i sx16 = _mm512_maddubs_epi16(_mm512_set1_epi8(1), xv);
+        const __m512i sx32 = _mm512_madd_epi16(sx16, _mm512_set1_epi16(1));
+        const float xscale0 = GGML_CPU_FP16_TO_FP32(x0->d);
+        const float xscale1 = GGML_CPU_FP16_TO_FP32(x1->d);
+
+        const block_q2_0 *w0 = (const block_q2_0 *)
+            ((const char *) weights + 0 * weight_row_bytes) + b;
+        const block_q2_0 *w1 = (const block_q2_0 *)
+            ((const char *) weights + 1 * weight_row_bytes) + b;
+        const block_q2_0 *w2 = (const block_q2_0 *)
+            ((const char *) weights + 2 * weight_row_bytes) + b;
+        const block_q2_0 *w3 = (const block_q2_0 *)
+            ((const char *) weights + 3 * weight_row_bytes) + b;
+
+        const __m512i wv0 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(zeromoe_ggml_q2_0_unpack_half_vnni(w0->qs)),
+            zeromoe_ggml_q2_0_unpack_half_vnni(w0->qs + 8), 1);
+        const __m512i wv1 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(zeromoe_ggml_q2_0_unpack_half_vnni(w1->qs)),
+            zeromoe_ggml_q2_0_unpack_half_vnni(w1->qs + 8), 1);
+        const __m512i wv2 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(zeromoe_ggml_q2_0_unpack_half_vnni(w2->qs)),
+            zeromoe_ggml_q2_0_unpack_half_vnni(w2->qs + 8), 1);
+        const __m512i wv3 = _mm512_inserti64x4(
+            _mm512_castsi256_si512(zeromoe_ggml_q2_0_unpack_half_vnni(w3->qs)),
+            zeromoe_ggml_q2_0_unpack_half_vnni(w3->qs + 8), 1);
+
+        const __m512i corrected0 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv0, xv), sx32);
+        const __m512i corrected1 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv1, xv), sx32);
+        const __m512i corrected2 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv2, xv), sx32);
+        const __m512i corrected3 = _mm512_sub_epi32(
+            _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv3, xv), sx32);
+
+        const float weight_scale0 = GGML_CPU_FP16_TO_FP32(w0->d);
+        const float weight_scale1 = GGML_CPU_FP16_TO_FP32(w1->d);
+        const float weight_scale2 = GGML_CPU_FP16_TO_FP32(w2->d);
+        const float weight_scale3 = GGML_CPU_FP16_TO_FP32(w3->d);
+        const __m512 scales00 = _mm512_set1_ps(weight_scale0 * xscale0);
+        const __m512 scales01 = _mm512_set1_ps(weight_scale0 * xscale1);
+        const __m512 scales10 = _mm512_set1_ps(weight_scale1 * xscale0);
+        const __m512 scales11 = _mm512_set1_ps(weight_scale1 * xscale1);
+        const __m512 scales20 = _mm512_set1_ps(weight_scale2 * xscale0);
+        const __m512 scales21 = _mm512_set1_ps(weight_scale2 * xscale1);
+        const __m512 scales30 = _mm512_set1_ps(weight_scale3 * xscale0);
+        const __m512 scales31 = _mm512_set1_ps(weight_scale3 * xscale1);
+
+        accum0 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected0),
+            _mm512_mask_blend_ps(0xff00, scales00, scales01), accum0);
+        accum1 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected1),
+            _mm512_mask_blend_ps(0xff00, scales10, scales11), accum1);
+        accum2 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected2),
+            _mm512_mask_blend_ps(0xff00, scales20, scales21), accum2);
+        accum3 = _mm512_fmadd_ps(
+            _mm512_cvtepi32_ps(corrected3),
+            _mm512_mask_blend_ps(0xff00, scales30, scales31), accum3);
+    }
+
+    output[0] = _mm512_reduce_add_ps(accum0);
+    output[1] = _mm512_reduce_add_ps(accum1);
+    output[2] = _mm512_reduce_add_ps(accum2);
+    output[3] = _mm512_reduce_add_ps(accum3);
+}
+
+static int zeromoe_ggml_q2_0_vnni_dispatch_enabled(void) {
+    static int cached = -1;
+    int enabled = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    if (enabled < 0) {
+        __builtin_cpu_init();
+        const char *disable = getenv("ZEROMOE_GGML_Q2_0_DISABLE_VNNI");
+        const int detected = (!disable || disable[0] != '1') &&
+            __builtin_cpu_supports("avx512vnni");
+        int expected = -1;
+        __atomic_compare_exchange_n(&cached, &expected, detected, 0,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+        enabled = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    }
+    return enabled;
+}
+#endif
+
+// ZeroMoE: AVX-512 VNNI Q2_0 dot (1 and 4 rows) and the multi-row loop. Returns 1 when it handled the call;
+// the single-row non-VNNI case falls through to the AVX2 kernel below.
+static int zeromoe_ggml_vec_dot_q2_0_q8_0_vnni(int n, float * GGML_RESTRICT s, size_t bs,
+                           const void * GGML_RESTRICT vx, size_t bx,
+                           const void * GGML_RESTRICT vy, size_t by, int nrc) {
+#if defined(__GNUC__) || defined(__clang__)
+    if (nrc == 4 && by == 0 && bs == sizeof(float) &&
+        zeromoe_ggml_q2_0_vnni_dispatch_enabled()) {
+        assert(n % QK2_0 == 0);
+        zeromoe_ggml_q2_0_dot_vnni_4rows(
+            s, vx, bx, vy, n);
+        return 1;
+    }
+    if (nrc == 1 && zeromoe_ggml_q2_0_vnni_dispatch_enabled()) {
+        assert(n % QK2_0 == 0);
+        const block_q2_0 * GGML_RESTRICT x = vx;
+        const block_q8_0 * GGML_RESTRICT y = vy;
+        *s = zeromoe_ggml_q2_0_dot_vnni(x, y, n);
+        return 1;
+    }
+#endif
+    if (nrc > 1) {
+        for (int row = 0; row < nrc; ++row) {
+            ggml_vec_dot_q2_0_q8_0_generic(
+                n, (float *) ((char *) s + row * bs), 0,
+                (const char *) vx + row * bx, 0,
+                (const char *) vy + row * by, 0, 1);
+        }
+        return 1;
+    }
+    return 0;
+}
