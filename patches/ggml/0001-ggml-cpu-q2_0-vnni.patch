+    if (zeromoe_ggml_vec_dot_q2_0_q8_0_vnni(n, s, bs, vx, bx, vy, by, nrc)) {
+        return;
+    }
 #if defined(__AVX2__)
     assert(n % QK2_0 == 0);
     assert(nrc == 1);
