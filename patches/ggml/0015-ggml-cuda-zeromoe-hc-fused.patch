diff -ruN a/src/ggml-cuda/zm-hc.cu b/src/ggml-cuda/zm-hc.cu
--- a/src/ggml-cuda/zm-hc.cu	1970-01-01 10:00:00.000000000 +1000
+++ b/src/ggml-cuda/zm-hc.cu	2026-10-28 09:24:34.004128434 +1100
@@ -0,0 +1,65 @@
+#include "zm-hc.cuh"
+
+// ggml's op_sigmoid, verbatim.
+static __device__ __forceinline__ float zm_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));
+}
+
+// zm_hc_combine: out[d,h,s] = res[d,h,s] + blk[d,s] * (2 * sigmoid(inj[h,s] * k))
+//   replaces SCALE(k) -> SIGMOID -> SCALE(2) -> REPEAT -> MUL -> ADD. The multiply and add stay separate
+//   roundings (the unfused chain is separate kernels), hence the explicit __fmul_rn / __fadd_rn.
+static __global__ void zm_hc_combine_kernel(const float * res, const float * blk, const float * inj, float * dst,
+                                            const int D, const int HC, const int64_t total, const float k) {
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < total; i += (int64_t) blockDim.x * gridDim.x) {
+        const int d = (int) (i % D);
+        const int64_t r = i / D;
+        const int h = (int) (r % HC);
+        const int64_t s = r / HC;
+        const float x   = k * inj[s * HC + h] + 0.0f;
+        const float w   = 2.0f * zm_sigmoid(x) + 0.0f;
+        dst[i] = __fadd_rn(res[i], __fmul_rn(blk[s * D + d], w));
+    }
+}
+
+// zm_hc_mix: out[d,s] = k * ((((x[0,d]*sig(l[0,d])) + x[1,d]*sig(l[1,d])) + ...)) over the HC streams,
+//   replaces SIGMOID -> MUL -> CONT -> ADD x (HC-1) -> SCALE(k). x, l are [D*HC, S]; stream h of token s at s*D*HC + h*D + d.
+static __global__ void zm_hc_mix_kernel(const float * x, const float * l, float * dst,
+                                        const int D, const int HC, const int64_t total, const float k) {
+    for (int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; i < total; i += (int64_t) blockDim.x * gridDim.x) {
+        const int d = (int) (i % D);
+        const int64_t s = i / D;
+        const float * xs = x + s * D * HC + d;
+        const float * ls = l + s * D * HC + d;
+        float acc = __fmul_rn(xs[0], zm_sigmoid(ls[0]));
+        for (int h = 1; h < HC; ++h) {
+            acc = __fadd_rn(acc, __fmul_rn(xs[h * D], zm_sigmoid(ls[h * D])));
+        }
+        dst[i] = k * acc + 0.0f;
+    }
+}
+
+void ggml_cuda_op_zm_hc(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    cudaStream_t stream = ctx.stream();
+    const int   kind = dst->op_params[0];  // 0 = combine, 1 = mix
+    const int   D    = dst->op_params[1];
+    const int   HC   = dst->op_params[2];
+    float       k;
+    memcpy(&k, &dst->op_params[3], sizeof(float));
+    const int64_t total = ggml_nelements(dst);
+    const int block = 256;
+    const int grid  = (int) std::min<int64_t>((total + block - 1) / block, 65535);
+    if (kind == 0) {
+        GGML_ASSERT(dst->src[0]->data && dst->src[1] && dst->src[2]);
+        zm_hc_combine_kernel<<<grid, block, 0, stream>>>((const float *) dst->src[0]->data, (const float *) dst->src[1]->data,
+                                                         (const float *) dst->src[2]->data, (float *) dst->data, D, HC, total, k);
+    } else {
+        zm_hc_mix_kernel<<<grid, block, 0, stream>>>((const float *) dst->src[0]->data, (const float *) dst->src[1]->data,
+                                                     (float *) dst->data, D, HC, total, k);
+    }
+}
+
+// Lets ZeroMoE detect at run time that this ggml carries the fused hyper-connection ops (a weak reference resolves to
+// null against an unpatched ggml, and the graph builder then emits the plain node chain).
+extern "C" int zeromoe_ggml_cuda_hc_fused_version(void) {
+    return 1;
+}
