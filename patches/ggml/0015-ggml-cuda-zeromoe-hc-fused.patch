+++ b/src/ggml-cuda/zm-hc.cuh	2026-10-28 09:24:11.432795361 +1100
@@ -0,0 +1,11 @@
+#pragma once
+#include "common.cuh"
+#include "ggml.h"
+
+// ZeroMoE Qwen4Exp hyper-connection ops carried on GGML_OP_ADD nodes whose op_params[7] is ZM_HC_MAGIC (see
+// zeromoe/ docs/design). Each reproduces the exact float sequence of the unfused ggml node chain it replaces.
+#define ZM_HC_MAGIC 0x5a4d4843  // "ZMHC" in op_params[7]
+static inline bool ggml_cuda_is_zm_hc(const ggml_tensor * t) {
+    return t->op == GGML_OP_ADD && t->op_params[7] == ZM_HC_MAGIC;
+}
+void ggml_cuda_op_zm_hc(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
