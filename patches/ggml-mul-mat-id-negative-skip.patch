+// MoEStream: advertises that GGML_OP_MUL_MAT_ID treats a negative expert id as an inactive route
+// (CPU: zero the output row, read no weights -- see moestream_mmid_negative_skip above; CUDA: the
+// MMVQ decode kernels do the same). include/mmid_route_skip.hpp weak-links this symbol: when it is
+// absent the split-layer graph builders fall back to a dummy expert id + mask and every branch
+// computes all top-k routes.
+GGML_BACKEND_API int ggml_cpu_mul_mat_id_negative_skip(void) {
+    return 1;
