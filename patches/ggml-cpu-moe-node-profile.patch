diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -2566,9 +2566,20 @@
 static inline bool ggml_cpu_profile_moe_nodes_enabled(void) {
     const char * value = getenv("BEE_GGML_PROFILE_CPU_NODES");
-    return value != NULL && value[0] == '1';
+    const char * breakdown = getenv("MOESTREAM_QWEN4EXP_CPU_CALLBACK_BREAKDOWN");
+    return (value != NULL && value[0] == '1') ||
+        (breakdown != NULL && breakdown[0] == '1');
 }
 
 static inline bool ggml_cpu_profile_moe_node(const struct ggml_tensor * node) {
-    return node != NULL &&
-        (node->op == GGML_OP_MUL_MAT_ID || node->op == GGML_OP_GLU);
+    if (node == NULL) {
+        return false;
+    }
+    if (node->op == GGML_OP_MUL_MAT_ID || node->op == GGML_OP_GLU) {
+        return true;
+    }
+    const char * breakdown = getenv("MOESTREAM_QWEN4EXP_CPU_CALLBACK_BREAKDOWN");
+    return breakdown != NULL && breakdown[0] == '1' &&
+        (node->op == GGML_OP_MUL || node->op == GGML_OP_ADD ||
+         node->op == GGML_OP_CONT) &&
+        strstr(node->name, "qwen4exp_cpu_moe_") != NULL;
 }
