diff --git a/src/ggml-cpu/arch/x86/quants.c b/src/ggml-cpu/arch/x86/quants.c
--- a/src/ggml-cpu/arch/x86/quants.c
+++ b/src/ggml-cpu/arch/x86/quants.c
@@ -11,6 +11,7 @@
 #include <math.h>
 #include <string.h>
 #include <assert.h>
 #include <stdlib.h> // for qsort
 #include <stdio.h>  // for GGML_ASSERT
+#include <immintrin.h>
 
@@ -23,3 +24,87 @@
 #define UNUSED GGML_UNUSED
 
+#if defined(__GNUC__) || defined(__clang__)
+#define MOESTREAM_Q2_0_VNNI_TARGET \
+    __attribute__((target("avx2,avx512f,avx512bw,avx512vl,avx512vnni")))
+
+static MOESTREAM_Q2_0_VNNI_TARGET __m256i
+moestream_ggml_q2_0_unpack_half_vnni(const uint8_t *packed) {
+    const __m128i bytes = _mm_loadl_epi64((const __m128i *) packed);
+    const __m256i q = _mm256_inserti128_si256(
+        _mm256_castsi128_si256(bytes), _mm_srli_si128(bytes, 4), 1);
+    const __m256i mask = _mm256_set1_epi8(0x03);
+    const __m256i q0 = _mm256_and_si256(q, mask);
+    const __m256i q1 = _mm256_and_si256(_mm256_srli_epi16(q, 2), mask);
+    const __m256i q2 = _mm256_and_si256(_mm256_srli_epi16(q, 4), mask);
+    const __m256i q3 = _mm256_and_si256(_mm256_srli_epi16(q, 6), mask);
+    const __m256i q01 = _mm256_unpacklo_epi8(q0, q1);
+    const __m256i q23 = _mm256_unpacklo_epi8(q2, q3);
+    return _mm256_unpacklo_epi16(q01, q23);
+}
+
+static MOESTREAM_Q2_0_VNNI_TARGET float
+moestream_ggml_q2_0_dot_vnni(const block_q2_0 *weights,
+                             const block_q8_0 *activations, int n) {
+    __m512 accum = _mm512_setzero_ps();
+    const int blocks = n / QK2_0;
+    for (int b = 0; b < blocks; ++b) {
+        const block_q2_0 *wb = &weights[b];
+        const float wd = GGML_CPU_FP16_TO_FP32(wb->d);
+        const __m256i w0 = moestream_ggml_q2_0_unpack_half_vnni(wb->qs);
+        const __m256i w1 = moestream_ggml_q2_0_unpack_half_vnni(wb->qs + 8);
+        const block_q8_0 *x0 = &activations[2 * b];
+        const block_q8_0 *x1 = &activations[2 * b + 1];
+        const __m512i wv = _mm512_inserti64x4(_mm512_castsi256_si512(w0), w1, 1);
+        const __m512i xv = _mm512_inserti64x4(
+            _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) x0->qs)),
+            _mm256_loadu_si256((const __m256i *) x1->qs), 1);
+        const __m512i sums = _mm512_dpbusd_epi32(_mm512_setzero_si512(), wv, xv);
+        const __m512i sx32 = _mm512_dpbusd_epi32(
+            _mm512_setzero_si512(), _mm512_set1_epi8(1), xv);
+        const __m512i corrected = _mm512_sub_epi32(sums, sx32);
+        const __m512 scale0 = _mm512_set1_ps(
+            wd * GGML_CPU_FP16_TO_FP32(x0->d));
+        const __m512 scale1 = _mm512_set1_ps(
+            wd * GGML_CPU_FP16_TO_FP32(x1->d));
+        const __m512 scales = _mm512_mask_blend_ps(0xff00, scale0, scale1);
+        accum = _mm512_fmadd_ps(_mm512_cvtepi32_ps(corrected), scales, accum);
+    }
+    return _mm512_reduce_add_ps(accum);
+}
+
+static int moestream_ggml_q2_0_vnni_dispatch_enabled(void) {
+    static int cached = -1;
+    int enabled = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    if (enabled < 0) {
+        __builtin_cpu_init();
+        const char *disable = getenv("MOESTREAM_GGML_Q2_0_DISABLE_VNNI");
+        const int detected = (!disable || disable[0] != '1') &&
+            __builtin_cpu_supports("avx512vnni");
+        int expected = -1;
+        __atomic_compare_exchange_n(&cached, &expected, detected, 0,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+        enabled = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    }
+    return enabled;
+}
+#endif
+
+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs,
+                           const void * GGML_RESTRICT vx, size_t bx,
+                           const void * GGML_RESTRICT vy, size_t by, int nrc) {
+#if defined(__GNUC__) || defined(__clang__)
+    if (nrc == 1 && moestream_ggml_q2_0_vnni_dispatch_enabled()) {
+        assert(n % QK2_0 == 0);
+        const block_q2_0 * GGML_RESTRICT x = vx;
+        const block_q8_0 * GGML_RESTRICT y = vy;
+        *s = moestream_ggml_q2_0_dot_vnni(x, y, n);
+        return;
+    }
+#endif
+    UNUSED(bs);
+    UNUSED(bx);
+    UNUSED(by);
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+}
+
 // some compilers don't provide _mm256_set_m128i, e.g. gcc 7
