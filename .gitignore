# --- Build outputs & compiled artifacts (NEVER commit these) ---
build/
build_*/
/build-cpu/
/build-cuda/
/build-ling/
/builds*/*
/.worktrees/
/.exl3-runtime/
tests/bench_outproj

# Keep the published starter profiles and generic templates in Git. Other
# root-level profiles remain local; benchmark profiles live under configs/bench.
/configs/*.toml
/configs/obsolete/
/configs/testing/
!/configs/qwen38-flash.toml
!/configs/glm53-flash.toml
!/configs/ling31-flash.toml
!/configs/deepseek41-flash.toml
!/configs/glm53-dsa.toml
!/configs/mimo26-flash.toml
!/configs/single_gpu.toml

# Local benchmark profiles are generated per prompt/run. Keep the committed
# reference inputs explicit; everything else stays on the host.
/bench/ling/reference-audit/usage-*.pin
!/bench/ling/reference-audit/usage-hi-there-robust4.pin
/bench/ling/reference-audit/prefill-*.pin
!/bench/ling/reference-audit/prefill-long64-ring-r05-20261020.pin
tests/test_components
tools/dump_expert_bytes
glm_runs/probe
glm_runs/probe_live
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.lib

# --- Model / binary data blobs ---
*.bin
*.pkl
*.npy
*.npz
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.engine

# --- Logs & run outputs (NEVER commit these) ---
*.log
*.log.*
*.out
*.stdout
*.stderr
*.done
*.bad
*.bad[0-9]*
*.bad*.*
*.csv
*.tsv
.zeromoe_*usage*
/bench_tmp/
/logs/
glm_runs/*.log
glm_runs/*.csv
glm_runs/*.stdout
glm_runs/*.out
glm_runs/*.done

# --- Test run outputs ---
tests/moe_usage_survey/responses/
tests/moe_usage_survey/index.tsv
tests/moe_usage_survey/*.csv

# --- Python caches ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Tool/IDE caches ---
.serena/
.claude/
.idea/
.vscode-cache/

# perf_report.py working files (the .json records are kept)
bench/results/*.logs/
bench/results/*.attempts.jsonl
bench/results/*.runs.jsonl
bench/results/*.rejected.jsonl
