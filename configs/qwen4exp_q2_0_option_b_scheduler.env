# Validated Q2_0 0/44/4 scheduler profile for the RTX 3090.
# Source this alongside qwen4exp_q2_0_option_b_rightsize_split44_x0_cov80.toml.
# Requires the patched llama.cpp-moestream-integration build; see
# ../docs/option-b-graph-refactor-steps-2026-10-04.md.
export CUDA_VISIBLE_DEVICES=0
export GGML_CUDA_BF16_MMVF_CUBLAS=0
export ZEROMOE_QWEN4EXP_FULL_GRAPH=1
export ZEROMOE_QWEN4EXP_FULL_GRAPH_DECODE=1
export ZEROMOE_QWEN4EXP_GRAPH_PRELOAD_LAYERS=0
export ZEROMOE_QWEN4EXP_GRAPH_PRELOAD_TRAILING=1
export ZEROMOE_QWEN_CPU_THREADS=10
export ZEROMOE_QWEN_EARLY_READY_LAYER13=0
export ZEROMOE_QWEN_EARLY_READY_ALL_SPLIT=1
export ZEROMOE_QWEN_EARLY_READY_RESIDENT_TABLES=1
export ZEROMOE_QWEN_EARLY_READY_ASYNC_OUTPUT=1
export ZEROMOE_QWEN_EARLY_READY_SKIP_ALL_HOT=0
export ZEROMOE_QWEN_EARLY_READY_PREDICT=0
unset ZEROMOE_QWEN_EARLY_READY_STAGE_LAYER
unset ZEROMOE_QWEN_EARLY_READY_STAGE_VERIFY
unset ZEROMOE_QWEN_EARLY_READY_STAGE_DELAY_US
unset ZEROMOE_QWEN_EARLY_READY_STAGE_WORKER_DELAY_US
unset ZEROMOE_QWEN_EARLY_READY_ROUTE_TRACE
